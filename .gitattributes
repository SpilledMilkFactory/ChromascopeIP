# Consistent source line endings across Linux and Windows.
* text=auto
*.sh text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
CMakePresets.json text eol=lf
CMakeUserPresets.json.example text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.patch text eol=lf

# License and NOTICE payloads are SHA-256 pinned to their upstream LF bytes.
# Git for Windows may otherwise convert .txt files to CRLF (core.autocrlf=true),
# causing genuine notice verification to fail during Windows packaging.
licenses/*.txt text eol=lf
models/LICENSE text eol=lf

# The original photographs and other binary media remain byte-identical.
*.jpg -text
*.jpeg -text
*.png -text
*.webp -text
*.zip -text

# Keep the M10.6 synthetic hex manifest byte-stable on Windows checkouts.
tests/fuzz/seeds/manifest.txt text eol=lf
