# Consistent source line endings across Linux and Windows.
* text=auto
*.sh text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
CMakePresets.json text eol=lf
CMakeUserPresets.json.example text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.patch text eol=lf

# The original photographs and other binary media remain byte-identical.
*.jpg -text
*.jpeg -text
*.png -text
*.webp -text
*.zip -text
