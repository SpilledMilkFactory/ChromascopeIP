# CMake / Ninja / FetchContent outputs: never commit downloaded ImGui or build products.
/build/
/build-*/
/cmake-build-*/
/out/build/
/CMakeFiles/
/CMakeCache.txt
/cmake_install.cmake
/CTestTestfile.cmake
/DartConfiguration.tcl
/Testing/
/compile_commands.json
/.ninja_deps
/.ninja_log

# Local toolchain, IDE and developer-specific CMake configuration.
/CMakeUserPresets.json
/.cache/
/.vs/
/.vscode/
/.idea/
*.user
*.suo
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Runtime exports and GUI state (not the historical sample fixtures).
/imgui.ini
/annotated.jpg
/annotated.png
/results.json
/out/
/results/

# Local/CI-fetched dependency prefix for Windows build validation
/.ci-opencv/

# Python policy-test and local tooling bytecode (never commit generated state).
__pycache__/
*.py[cod]

# v1.0.1: the single reviewed NanoDet checkpoint is permitted in Git.
# Other model weights remain ignored and are forbidden by model policy.
/models/*.onnx
!/models/object_detection_nanodet_2022nov.onnx
/models/*.pth
/models/*.pt
/models/*.bin
/models/cache/


/release/
