def decode_patch():
    try:
        packed = base64.b85decode("".join(PAYLOAD.split()).encode("ascii"))
        if hashlib.sha256(packed).hexdigest() != COMPRESSED_SHA256:
            raise ValueError("compressed payload digest mismatch")
        plain = lzma.decompress(packed)
        if len(plain) != PATCH_SIZE or hashlib.sha256(plain).hexdigest() != PATCH_SHA256:
            raise ValueError("Git patch length/digest mismatch")
        return plain
    except (ValueError, lzma.LZMAError) as error:
        raise SystemExit("Installer text appears damaged; checkout unchanged: " + str(error)) from error


def git(root, *args, payload=None):
    return subprocess.run(["git", *args], cwd=root, input=payload,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)


def die(message):
    print("M8.1: " + message, file=sys.stderr)
    raise SystemExit(2)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--check", action="store_true", help="check applicability only")
    mode.add_argument("--apply", action="store_true", help="apply after validation (default)")
    mode.add_argument("--write-patch", metavar="FILE", help="write plain patch without applying")
    args = parser.parse_args()
    patch = decode_patch()
    print("Verified M8.1 patch:", len(patch), "bytes, SHA-256", PATCH_SHA256)

    if args.write_patch:
        try:
            with open(args.write_patch, "xb") as out:
                out.write(patch)
        except OSError as error:
            die("could not create patch (will not overwrite): " + str(error))
        print("Created", args.write_patch, "(no repository changes)")
        return

    cwd = Path.cwd()
    try:
        top = git(cwd, "rev-parse", "--show-toplevel")
    except OSError as error:
        die("Git is unavailable: " + str(error))
    if top.returncode:
        die("run inside the existing ChromascopeIP Git checkout")
    root = Path(top.stdout.decode("utf-8").strip())
    if not (root / "tests/CMakeLists.txt").is_file() or not (root / "models/selected_model.json").is_file():
        die("this directory is not a recognizable ChromascopeIP checkout")
    if not args.check:
        # Do not install over unrelated tracked/staged edits. The copied
        # installer itself may be an untracked file; that is fine.
        if git(root, "diff", "--quiet").returncode or git(root, "diff", "--cached", "--quiet").returncode:
            die("tracked changes exist; commit or stash them before applying")
    dry = git(root, "apply", "--check", "-", payload=patch)
    if dry.returncode:
        reversed_check = git(root, "apply", "--reverse", "--check", "-", payload=patch)
        if not reversed_check.returncode:
            die("M8.1 appears already applied; no changes made")
        sys.stderr.write(dry.stderr.decode("utf-8", errors="replace"))
        die("patch does not match this M7.6 baseline; no files changed")
    print("PASS: git apply --check")
    if args.check:
        print("No repository files changed (--check).")
        return
    applied = git(root, "apply", "-", payload=patch)
    if applied.returncode:
        sys.stderr.write(applied.stderr.decode("utf-8", errors="replace"))
        die("Git could not apply M8.1; inspect git status")
    checked = git(root, "diff", "--check")
    if checked.returncode:
        sys.stderr.write(checked.stdout.decode("utf-8", errors="replace"))
        die("patch applied but git diff --check failed")
    print("PASS: M8.1 installed. Expected 113 CTests, 45 Python quality tests.")
    print("Review git diff, compile and run verification before committing.")


if __name__ == "__main__":
    main()
