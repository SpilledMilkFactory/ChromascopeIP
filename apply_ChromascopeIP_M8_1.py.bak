#!/usr/bin/env python3
"""ChromascopeIP M8.1 (#53) offline Git patch installer.

Requires only Python 3 standard library and Git; never fetches code.

From the actual project Git checkout:
    python3 apply_ChromascopeIP_M8_1.py --check
    python3 apply_ChromascopeIP_M8_1.py --apply

Recover the original plain Git patch without changing the checkout:
    python3 apply_ChromascopeIP_M8_1.py --write-patch ChromascopeIP_M8_1.patch
"""

