# Explicit, pinned Windows FFmpeg 8.1.3 import-library discovery for OpenCV.
# Never allow OpenCV to download its prebuilt Windows FFmpeg wrapper.
if(NOT WIN32 OR NOT MSVC OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "Private P5 FFmpeg requires Windows x64/MSVC")
endif()
if(NOT IS_DIRECTORY "${CHROMASCOPE_PRIVATE_FFMPEG_PREFIX}")
    message(FATAL_ERROR "Missing reviewed P5 FFmpeg installation prefix")
endif()
set(_ffroot "${CHROMASCOPE_PRIVATE_FFMPEG_PREFIX}")
if(NOT EXISTS "${_ffroot}/.chromascope-ffmpeg-windows-p5.txt")
    message(FATAL_ERROR "Missing verified private FFmpeg provenance marker")
endif()
set(FFMPEG_INCLUDE_DIRS "${_ffroot}/include")
set(FFMPEG_LIBRARIES "")
foreach(_name IN ITEMS avcodec avformat avutil swscale)
    # FFmpeg n8.1.3's win64 shared build installs its .lib import libraries
    # alongside the DLLs in SHLIBDIR (normally bin), not necessarily LIBDIR.
    # Accept either upstream bin or a deliberately staged lib layout, but
    # reject ambiguous/duplicate imports instead of silently mixing builds.
    set(_candidates "")
    foreach(_dir IN ITEMS bin lib)
        foreach(_candidate IN ITEMS "${_name}.lib" "${_name}-62.lib" "${_name}-60.lib" "${_name}-9.lib")
            if(EXISTS "${_ffroot}/${_dir}/${_candidate}" AND
               NOT IS_DIRECTORY "${_ffroot}/${_dir}/${_candidate}")
                list(APPEND _candidates "${_ffroot}/${_dir}/${_candidate}")
            endif()
        endforeach()
    endforeach()
    list(LENGTH _candidates _count)
    if(NOT _count EQUAL 1)
        message(FATAL_ERROR "Expected exactly one private MSVC import library for ${_name}: ${_candidates}")
    endif()
    list(APPEND FFMPEG_LIBRARIES "${_candidates}")
    if(_name STREQUAL "avutil")
        set(FFMPEG_lib${_name}_VERSION "60.0.0")
    elseif(_name STREQUAL "swscale")
        set(FFMPEG_lib${_name}_VERSION "9.0.0")
    else()
        set(FFMPEG_lib${_name}_VERSION "62.0.0")
    endif()
endforeach()
set(FFMPEG_FOUND TRUE)
set(ChromascopePrivateFFmpeg_FOUND TRUE)
message(STATUS "Using reviewed private Windows FFmpeg: ${_ffroot}")
