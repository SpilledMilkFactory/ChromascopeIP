# M8.5: all cases fail in argument/destination validation, BEFORE camera I/O.
if(NOT DEFINED CHROMASCOPE_CLI OR NOT DEFINED CHROMASCOPE_EXPORT_DIR)
    message(FATAL_ERROR "M8.5 camera CLI test requires CLI and export directory")
endif()
file(REMOVE_RECURSE "${CHROMASCOPE_EXPORT_DIR}")
file(MAKE_DIRECTORY "${CHROMASCOPE_EXPORT_DIR}")
file(WRITE "${CHROMASCOPE_EXPORT_DIR}/sentinel.txt" "must-not-change")

function(expect_camera_rejected)
    execute_process(COMMAND "${CHROMASCOPE_CLI}" ${ARGN}
        WORKING_DIRECTORY "${CHROMASCOPE_EXPORT_DIR}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err
        TIMEOUT 10)
    if(rc EQUAL 0)
        message(FATAL_ERROR "Unexpectedly accepted invalid camera request: ${ARGN}: ${out}")
    endif()
    if(NOT err MATCHES "camera|Camera|argument|Unknown")
        message(FATAL_ERROR "Expected camera argument failure for ${ARGN}: ${err}")
    endif()
endfunction()
expect_camera_rejected(--camera -1)
expect_camera_rejected(--camera 256)
expect_camera_rejected(--camera 0 --camera-max-frames 0)
expect_camera_rejected(--camera 0 --camera-max-frames 301)
expect_camera_rejected(--camera 0 --camera-max-seconds 0)
expect_camera_rejected(--camera 0 --camera-max-seconds 61)
expect_camera_rejected(--camera 0 --camera-backend auto)
expect_camera_rejected(--camera 0 --camera 1)
expect_camera_rejected(--camera 0 --input sample.png)
expect_camera_rejected(--camera 0 --help)
expect_camera_rejected(--help --camera 0)
expect_camera_rejected(--camera 0 --camera-save-dir "${CHROMASCOPE_EXPORT_DIR}")
expect_camera_rejected(--camera 0 --camera-save-dir "${CHROMASCOPE_EXPORT_DIR}/sentinel.txt")
file(READ "${CHROMASCOPE_EXPORT_DIR}/sentinel.txt" sentinel)
if(NOT sentinel STREQUAL "must-not-change")
    message(FATAL_ERROR "Camera CLI modified pre-existing output")
endif()
file(GLOB files "${CHROMASCOPE_EXPORT_DIR}/*")
list(LENGTH files count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "Camera CLI wrote unexpected files during rejected requests: ${files}")
endif()
