cmake_minimum_required(VERSION 3.24)
# Real CLI integration test: native process + output files + parsed JSON contract.
# This deliberately avoids shell quoting, Python, and external JSON dependencies.
foreach(_variable CHROMASCOPE_CLI CHROMASCOPE_INPUT CHROMASCOPE_EXPORT_DIR)
    if(NOT DEFINED ${_variable})
        message(FATAL_ERROR "missing ${_variable}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${CHROMASCOPE_EXPORT_DIR}")
set(_json_path "${CHROMASCOPE_EXPORT_DIR}/s2-results.json")
set(_image_path "${CHROMASCOPE_EXPORT_DIR}/s2-annotated.png")
file(REMOVE "${_json_path}" "${_image_path}")

execute_process(
    COMMAND "${CHROMASCOPE_CLI}" --input "${CHROMASCOPE_INPUT}"
            --output "${_image_path}" --json "${_json_path}"
    RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr
)
if(NOT "${_status}" STREQUAL "0")
    message(FATAL_ERROR "CLI export failed (${_status}): ${_stderr}")
endif()
foreach(_path "${_json_path}" "${_image_path}")
    if(NOT EXISTS "${_path}")
        message(FATAL_ERROR "CLI did not create ${_path}")
    endif()
    file(SIZE "${_path}" _bytes)
    if(_bytes LESS 100)
        message(FATAL_ERROR "CLI produced unexpectedly small output: ${_path}")
    endif()
endforeach()
file(READ "${_image_path}" _png_header LIMIT 8 HEX)
if(NOT _png_header STREQUAL "89504e470d0a1a0a")
    message(FATAL_ERROR "CLI image does not have a PNG signature")
endif()

file(READ "${_json_path}" _json)
string(JSON _app GET "${_json}" application)
string(JSON _profile GET "${_json}" profile)
string(JSON _width GET "${_json}" width)
string(JSON _height GET "${_json}" height)
string(JSON _total GET "${_json}" total)
string(JSON _length LENGTH "${_json}" detections)
if(NOT _app STREQUAL "ChromascopeIP" OR NOT _profile STREQUAL "skittles")
    message(FATAL_ERROR "CLI JSON contains the wrong application or profile")
endif()
if(NOT _width EQUAL 4032 OR NOT _height EQUAL 3024)
    message(FATAL_ERROR "CLI JSON dimensions do not match the original image")
endif()
if(_total LESS 8 OR _total GREATER 10 OR NOT _total EQUAL _length)
    message(FATAL_ERROR "CLI JSON detection list/count mismatch: ${_total} versus ${_length}")
endif()
set(_sum 0)
foreach(_color red orange yellow lime purple)
    string(JSON _value GET "${_json}" counts "${_color}")
    math(EXPR _sum "${_sum} + ${_value}")
endforeach()
if(NOT _sum EQUAL _total)
    message(FATAL_ERROR "CLI JSON color counts do not sum to total")
endif()
string(JSON _red GET "${_json}" counts red)
if(_red LESS 2)
    message(FATAL_ERROR "CLI JSON lost the M0.1 s2 red-candy regression")
endif()

# --json - must be machine-readable on stdout, without console summary noise.
execute_process(
    COMMAND "${CHROMASCOPE_CLI}" --input "${CHROMASCOPE_INPUT}" --json -
    RESULT_VARIABLE _stdout_status OUTPUT_VARIABLE _stdout_json ERROR_VARIABLE _stdout_error
)
if(NOT "${_stdout_status}" STREQUAL "0")
    message(FATAL_ERROR "CLI stdout JSON invocation failed: ${_stdout_error}")
endif()
string(JSON _stdout_app GET "${_stdout_json}" application)
string(JSON _stdout_total GET "${_stdout_json}" total)
if(NOT _stdout_app STREQUAL "ChromascopeIP" OR NOT _stdout_total EQUAL _total)
    message(FATAL_ERROR "CLI stdout JSON has incorrect structure or detection total")
endif()
message(STATUS "PASS: CLI PNG + JSON file/stdout exports (${_total} detections)")
