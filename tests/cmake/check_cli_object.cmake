# M5.6: real CLI rejected-input paths, no pretrained weights required.
if(NOT EXISTS "${CHROMASCOPE_CLI}" OR NOT EXISTS "${CHROMASCOPE_INPUT}")
    message(FATAL_ERROR "Missing CLI executable or source fixture")
endif()
file(MAKE_DIRECTORY "${CHROMASCOPE_EXPORT_DIR}")
set(fake "${CHROMASCOPE_EXPORT_DIR}/invalid.onnx")
file(WRITE "${fake}" "not-an-onnx-model\n")
file(SHA256 "${fake}" before_hash)
set(out "${CHROMASCOPE_EXPORT_DIR}/output.png")
set(json "${CHROMASCOPE_EXPORT_DIR}/results.json")
file(REMOVE "${out}" "${json}")
function(must_reject name)
    execute_process(COMMAND "${CHROMASCOPE_CLI}" --input "${CHROMASCOPE_INPUT}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE out_text ERROR_VARIABLE err_text
        TIMEOUT 15)
    if("${status}" STREQUAL "0")
        message(FATAL_ERROR "${name}: unexpectedly succeeded: ${out_text}")
    endif()
    if("${err_text}" STREQUAL "")
        message(FATAL_ERROR "${name}: expected stderr diagnostic")
    endif()
    if(EXISTS "${out}" OR EXISTS "${json}")
        message(FATAL_ERROR "${name}: rejected CLI operation created an export")
    endif()
endfunction()

must_reject("missing model" --profile object --json "${json}")
must_reject("bad digest" --profile object --model "${fake}" --json "${json}")
must_reject("model source alias" --profile object --model "${fake}" --output "${fake}")
must_reject("image source alias" --profile object --model "${fake}" --output "${CHROMASCOPE_INPUT}")
must_reject("bad threshold" --profile object --model "${fake}" --confidence 1.01 --json "${json}")
must_reject("NaN threshold" --profile object --model "${fake}" --nms nan --json "${json}")
must_reject("too many outputs" --profile object --model "${fake}" --max-detections 513 --json "${json}")
must_reject("unknown profile" --profile unsupported --model "${fake}")
must_reject("incompatible option" --profile object --model "${fake}" --set foo=0.5)
must_reject("video flags" --profile object --model "${fake}" --video-probe)
must_reject("missing explicit profile" --model "${fake}")
file(SHA256 "${fake}" after_hash)
if(NOT before_hash STREQUAL after_hash)
    message(FATAL_ERROR "Rejected CLI command modified the model fixture")
endif()
execute_process(COMMAND "${CHROMASCOPE_CLI}" --list-profiles
    RESULT_VARIABLE status OUTPUT_VARIABLE listed ERROR_VARIABLE errors TIMEOUT 15)
if(NOT status EQUAL 0 OR NOT listed MATCHES "object - NanoDet")
    message(FATAL_ERROR "Object profile not present in --list-profiles")
endif()
