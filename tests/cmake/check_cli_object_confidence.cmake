# Offline CLI option and class list checks; no pretrained ONNX checkpoint.
if(NOT EXISTS "${CHROMASCOPE_CLI}" OR NOT EXISTS "${CHROMASCOPE_INPUT}")
    message(FATAL_ERROR "M5.8 CLI or fixture is missing")
endif()
file(MAKE_DIRECTORY "${CHROMASCOPE_EXPORT_DIR}")
set(fake "${CHROMASCOPE_EXPORT_DIR}/invalid.onnx")
file(WRITE "${fake}" "not a model\n")
set(out "${CHROMASCOPE_EXPORT_DIR}/output.png")
set(json "${CHROMASCOPE_EXPORT_DIR}/results.json")
execute_process(COMMAND "${CHROMASCOPE_CLI}" --list-object-classes
    RESULT_VARIABLE result OUTPUT_VARIABLE classes ERROR_VARIABLE errors TIMEOUT 10)
if(NOT result EQUAL 0 OR NOT classes MATCHES "0[\t ]+person" OR
   NOT classes MATCHES "33[\t ]+kite" OR NOT classes MATCHES "79[\t ]+toothbrush")
    message(FATAL_ERROR "Object class enumeration missing or inconsistent: ${classes} ${errors}")
endif()
execute_process(COMMAND "${CHROMASCOPE_CLI}" --list-profiles
    RESULT_VARIABLE result OUTPUT_VARIABLE profiles ERROR_VARIABLE errors TIMEOUT 10)
if(NOT result EQUAL 0 OR NOT profiles MATCHES "confidence=0.50")
    message(FATAL_ERROR "Conservative object profile default not advertised: ${profiles} ${errors}")
endif()
function(must_reject name)
    file(REMOVE "${out}" "${json}")
    execute_process(COMMAND "${CHROMASCOPE_CLI}" --input "${CHROMASCOPE_INPUT}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 15)
    if("${result}" STREQUAL "0" OR "${stderr}" STREQUAL "")
        message(FATAL_ERROR "${name}: should reject with diagnostic; stdout=${stdout}, stderr=${stderr}")
    endif()
    if(EXISTS "${out}" OR EXISTS "${json}")
        message(FATAL_ERROR "${name}: rejected command created output")
    endif()
endfunction()
must_reject("bad name" --profile object --model "${fake}" --class-threshold candy=0.9 --json "${json}")
must_reject("bad numeric class" --profile object --model "${fake}" --class-threshold 80=0.9 --json "${json}")
must_reject("malformed override" --profile object --model "${fake}" --class-threshold kite --json "${json}")
must_reject("duplicate override" --profile object --model "${fake}" --class-threshold kite=0.7 --class-threshold 33=0.8 --json "${json}")
must_reject("NaN override" --profile object --model "${fake}" --class-threshold kite=nan --json "${json}")
must_reject("invalid floor" --profile object --model "${fake}" --uncertain-floor -0.2 --json "${json}")
must_reject("extra profile" --profile skittles --class-threshold kite=0.7)
must_reject("extra diagnostic" --profile skittles --uncertain-floor 0.3)
must_reject("list mixed" --list-object-classes --profile object --model "${fake}")
