# No external model downloads; reject bad person-profile options before I/O.
if(NOT EXISTS "${CHROMASCOPE_CLI}" OR NOT EXISTS "${CHROMASCOPE_INPUT}")
    message(FATAL_ERROR "Person-profile CLI or test fixture missing")
endif()
file(MAKE_DIRECTORY "${CHROMASCOPE_EXPORT_DIR}")
set(fake "${CHROMASCOPE_EXPORT_DIR}/bad.onnx")
file(WRITE "${fake}" "not approved ONNX weights\n")
set(output "${CHROMASCOPE_EXPORT_DIR}/invalid-person.json")
execute_process(COMMAND "${CHROMASCOPE_CLI}" --list-profiles
    RESULT_VARIABLE result OUTPUT_VARIABLE profiles ERROR_VARIABLE errors TIMEOUT 10)
if(NOT result EQUAL 0 OR NOT profiles MATCHES "person - COCO class 0 only")
    message(FATAL_ERROR "Missing --profile person in CLI help: ${profiles} ${errors}")
endif()
execute_process(COMMAND "${CHROMASCOPE_CLI}" --help
    RESULT_VARIABLE result OUTPUT_VARIABLE help ERROR_VARIABLE errors TIMEOUT 10)
if(NOT result EQUAL 0 OR NOT help MATCHES "--display-threshold")
    message(FATAL_ERROR "Person display cutoff not documented in CLI")
endif()
function(must_reject name)
    file(REMOVE "${output}")
    execute_process(COMMAND "${CHROMASCOPE_CLI}" --input "${CHROMASCOPE_INPUT}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 15)
    if("${result}" STREQUAL "0" OR "${stderr}" STREQUAL "")
        message(FATAL_ERROR "${name}: should reject: stdout=${stdout}; stderr=${stderr}")
    endif()
    if(EXISTS "${output}")
        message(FATAL_ERROR "${name}: rejected request created output")
    endif()
endfunction()
must_reject("negative cutoff" --profile person --model "${fake}" --display-threshold -0.1 --json "${output}")
must_reject("cutoff above one" --profile person --model "${fake}" --display-threshold 1.01 --json "${output}")
must_reject("NaN cutoff" --profile person --model "${fake}" --display-threshold nan --json "${output}")
must_reject("duplicate cutoff" --profile person --model "${fake}" --display-threshold 0.7 --display-threshold 0.9 --json "${output}")
must_reject("object profile cannot use display" --profile object --model "${fake}" --display-threshold 0.7 --json "${output}")
must_reject("skittles profile cannot use display" --profile skittles --display-threshold 0.7 --json "${output}")
must_reject("person excludes class overrides" --profile person --model "${fake}" --class-threshold kite=0.8 --json "${output}")
must_reject("model validation still enforced" --profile person --model "${fake}" --display-threshold 0.7 --json "${output}")
