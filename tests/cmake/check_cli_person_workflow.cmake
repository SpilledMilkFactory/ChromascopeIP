# M7.5: verify person-only alias uses the existing trusted-model path for
# each image/video action and never writes outputs on an untrusted model.
if(NOT EXISTS "${CHROMASCOPE_CLI}" OR NOT EXISTS "${CHROMASCOPE_INPUT}")
    message(FATAL_ERROR "M7.5 CLI or sample input missing")
endif()
file(MAKE_DIRECTORY "${CHROMASCOPE_EXPORT_DIR}")
set(fake "${CHROMASCOPE_EXPORT_DIR}/m7-5-untrusted.onnx")
file(WRITE "${fake}" "not approved model weights\n")
set(output "${CHROMASCOPE_EXPORT_DIR}/m7-5-output.json")
set(stream "${CHROMASCOPE_EXPORT_DIR}/m7-5-output.jsonl")
set(avi "${CHROMASCOPE_EXPORT_DIR}/m7-5-output.avi")
execute_process(COMMAND "${CHROMASCOPE_CLI}" --help
    RESULT_VARIABLE result OUTPUT_VARIABLE help ERROR_VARIABLE err TIMEOUT 15)
if(NOT "${result}" STREQUAL "0" OR NOT help MATCHES "--person-only" OR
   NOT help MATCHES "--profile person" OR NOT help MATCHES "--analyze-video")
    message(FATAL_ERROR "Person-only CLI example/flag missing from help")
endif()
function(check_reject name expected)
    file(REMOVE "${output}" "${stream}" "${avi}")
    execute_process(COMMAND "${CHROMASCOPE_CLI}" ${ARGN}
        RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 20)
    if("${code}" STREQUAL "0" OR NOT stderr MATCHES "${expected}")
        message(FATAL_ERROR "${name}: expected '${expected}' failure; exit=${code}; stdout=${stdout}; stderr=${stderr}")
    endif()
    if(EXISTS "${output}" OR EXISTS "${stream}" OR EXISTS "${avi}")
        message(FATAL_ERROR "${name}: refused request wrote output")
    endif()
endfunction()
# Conflicting aliases must fail irrespective of argument order.
check_reject("profile conflict" "Repeated or conflicting argument" --person-only --profile object --input "${CHROMASCOPE_INPUT}" --model "${fake}" --json "${output}")
check_reject("reverse conflict" "Repeated or conflicting argument" --profile person --person-only --input "${CHROMASCOPE_INPUT}" --model "${fake}" --json "${output}")
check_reject("legacy conflict" "Repeated or conflicting argument" --mode skittles --person-only --input "${CHROMASCOPE_INPUT}" --model "${fake}" --json "${output}")
check_reject("repeated alias" "Repeated or conflicting argument" --person-only --person-only --input "${CHROMASCOPE_INPUT}" --model "${fake}" --json "${output}")
check_reject("untrusted still model" "SHA-256 mismatch" --input "${CHROMASCOPE_INPUT}" --person-only --model "${fake}" --display-threshold 0.65 --json "${output}")
check_reject("bad cutoff" "person display threshold|must be|range" --input "${CHROMASCOPE_INPUT}" --person-only --model "${fake}" --display-threshold 1.5 --json "${output}")
check_reject("non-person class" "only person class thresholds" --input "${CHROMASCOPE_INPUT}" --person-only --model "${fake}" --class-threshold kite=0.8 --json "${output}")
check_reject("untrusted video frame" "SHA-256" --detect-video-frame 0 --input "${CHROMASCOPE_INPUT}" --person-only --model "${fake}" --json "${output}")
check_reject("untrusted JSONL" "SHA-256" --analyze-video --input "${CHROMASCOPE_INPUT}" --person-only --model "${fake}" --jsonl "${stream}")
check_reject("untrusted AVI" "SHA-256" --export-annotated-video --input "${CHROMASCOPE_INPUT}" --person-only --model "${fake}" --output "${avi}" --video-codec mjpeg --audio-policy drop)
check_reject("video probe rejects person alias" "Video probe/extraction cannot use" --video-probe --input "${CHROMASCOPE_INPUT}" --person-only --model "${fake}")
