if(NOT CHROMASCOPE_CLI OR NOT CHROMASCOPE_INPUT OR NOT CHROMASCOPE_EXPORT_DIR)
    message(FATAL_ERROR "Missing CLI, input, or output directory")
endif()
file(MAKE_DIRECTORY "${CHROMASCOPE_EXPORT_DIR}")
foreach(profile IN ITEMS hsv_segmentation contour_detection)
    set(annotated "${CHROMASCOPE_EXPORT_DIR}/${profile}.png")
    set(mask "${CHROMASCOPE_EXPORT_DIR}/${profile}-mask.png")
    set(json "${CHROMASCOPE_EXPORT_DIR}/${profile}.json")
    execute_process(COMMAND "${CHROMASCOPE_CLI}" --input "${CHROMASCOPE_INPUT}"
        --profile "${profile}" --output "${annotated}"
        --mask-output "${mask}" --json "${json}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${profile} CLI failed: ${error} ${output}")
    endif()
    foreach(file IN ITEMS "${annotated}" "${mask}" "${json}")
        if(NOT EXISTS "${file}")
            message(FATAL_ERROR "${profile} did not create ${file}")
        endif()
        file(SIZE "${file}" size)
        if(size LESS 30)
            message(FATAL_ERROR "${profile} produced a too-small file: ${file}")
        endif()
    endforeach()
    file(READ "${json}" content)
    if(NOT content MATCHES "\"profile\": \"${profile}\"")
        message(FATAL_ERROR "${profile} JSON has wrong processor identity")
    endif()
    string(FIND "${content}" "\"detections\": [" detections_position)
    if(detections_position EQUAL -1)
        message(FATAL_ERROR "${profile} JSON has no detection list")
    endif()
endforeach()
