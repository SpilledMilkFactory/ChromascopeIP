# M4.6: additive video JSON, explicit audio policy, media provenance.
foreach(_required CHROMASCOPE_CLI CHROMASCOPE_VIDEO_FIXTURE CHROMASCOPE_EXPORT_DIR)
    if(NOT DEFINED ${_required})
        message(FATAL_ERROR "Missing ${_required}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${CHROMASCOPE_EXPORT_DIR}")
set(_movie "${CHROMASCOPE_EXPORT_DIR}/m4-6-silent.avi")
execute_process(COMMAND "${CHROMASCOPE_VIDEO_FIXTURE}" generate "${_movie}"
    RESULT_VARIABLE _rc ERROR_VARIABLE _err)
if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "M4.6 fixture generation: ${_err}")
endif()
foreach(_mode probe extraction)
    if(_mode STREQUAL "probe")
        set(_args --video-probe)
    else()
        set(_args --extract-frame 2 --output "${CHROMASCOPE_EXPORT_DIR}/frame.png")
    endif()
    execute_process(COMMAND "${CHROMASCOPE_CLI}" --input "${_movie}"
        --video-backend opencv-mjpeg ${_args} --json -
        RESULT_VARIABLE _rc ERROR_VARIABLE _err OUTPUT_VARIABLE _json)
    if(NOT _rc EQUAL 0)
        message(FATAL_ERROR "M4.6 ${_mode}: ${_err}")
    endif()
    string(JSON _audio GET "${_json}" audio_handling)
    string(JSON _rotation_type TYPE "${_json}" rotation_clockwise_degrees)
    string(JSON _rotation GET "${_json}" rotation_clockwise_degrees)
    string(JSON _handling GET "${_json}" rotation_handling)
    if(_rotation_type STREQUAL "NULL")
        if(NOT _handling STREQUAL "invalid_metadata")
            message(FATAL_ERROR "Missing rotation metadata requires explicit status")
        endif()
    elseif(NOT _rotation EQUAL 0 OR NOT _handling STREQUAL "upright_or_unreported")
        message(FATAL_ERROR "M4.6 unrotated fixture unexpectedly has a rotation")
    endif()
    string(JSON _source GET "${_json}" frame timestamp_source)
    string(JSON _schema GET "${_json}" schema_version)
    if(NOT _schema EQUAL 1 OR NOT _audio STREQUAL "ignored" OR
       NOT _source MATCHES "^(decoder_reported|fps_estimate)$")
        message(FATAL_ERROR "Invalid M4.6 ${_mode} JSON contract: ${_json}")
    endif()
endforeach()
