# M5.7: offline, no Python interpreter or pretrained weights required by CTest.
if(NOT DEFINED CHROMASCOPE_SOURCE_ROOT OR CHROMASCOPE_SOURCE_ROOT STREQUAL "")
    message(FATAL_ERROR "M5.7 source root not provided")
endif()
set(_root "${CHROMASCOPE_SOURCE_ROOT}")
set(_fixtures "${_root}/tests/fixtures/object_detection")
foreach(_required IN ITEMS "models/model_provenance.json" "tests/fixtures/object_detection/manifest.json"
        "scripts/generate_object_fixtures.py" "scripts/check_object_provenance.py")
    if(NOT EXISTS "${_root}/${_required}")
        message(FATAL_ERROR "M5.7 required provenance file missing: ${_required}")
    endif()
endforeach()
file(READ "${_root}/models/model_provenance.json" _model)
file(READ "${_root}/models/selected_model.json" _selection)
foreach(_field IN ITEMS model_id file_name)
    string(JSON _expected GET "${_selection}" "${_field}")
    string(JSON _actual GET "${_model}" "${_field}")
    if(NOT _expected STREQUAL _actual)
        message(FATAL_ERROR "M5.7 model provenance ${_field} mismatch")
    endif()
endforeach()
string(JSON _sha GET "${_selection}" artifact_sha256)
string(JSON _attested_sha GET "${_model}" sha256)
if(NOT _sha STREQUAL _attested_sha OR NOT _sha STREQUAL
        "4b82da9944b88577175ee23a459dce2e26e6e4be573def65b1055dc2d9720186")
    message(FATAL_ERROR "M5.7 model provenance digest mismatch")
endif()
string(JSON _bundled GET "${_model}" weights_bundled)
string(JSON _review GET "${_model}" redistribution_review_required)
if(_bundled OR NOT _review)
    message(FATAL_ERROR "M5.7 cannot distribute model weights without release review")
endif()
file(READ "${_fixtures}/manifest.json" _json)
string(JSON _version GET "${_json}" schema_version)
string(JSON _count LENGTH "${_json}" fixtures)
if(NOT _version STREQUAL "1" OR NOT _count STREQUAL "5")
    message(FATAL_ERROR "M5.7 malformed object fixture provenance manifest")
endif()
set(_names
    synthetic_shapes_64x48.bmp
    synthetic_blank_64x48.bmp
    truncated_png.bin
    oversized_dimensions.bmp
    invalid_ihdr.png)
set(_index 0)
foreach(_name IN LISTS _names)
    string(JSON _filename GET "${_json}" fixtures ${_index} file)
    string(JSON _bytes GET "${_json}" fixtures ${_index} bytes)
    string(JSON _digest GET "${_json}" fixtures ${_index} sha256)
    if(NOT _filename STREQUAL _name OR NOT EXISTS "${_fixtures}/${_name}")
        message(FATAL_ERROR "M5.7 fixture missing or reordered: ${_name}")
    endif()
    file(SIZE "${_fixtures}/${_name}" _actual_bytes)
    file(SHA256 "${_fixtures}/${_name}" _actual_digest)
    if(NOT _bytes STREQUAL _actual_bytes OR NOT _digest STREQUAL _actual_digest)
        message(FATAL_ERROR "M5.7 fixture tampered: ${_name}")
    endif()
    math(EXPR _index "${_index} + 1")
endforeach()
file(GLOB _all LIST_DIRECTORIES FALSE "${_fixtures}/*")
list(LENGTH _all _actual_count)
if(NOT _actual_count EQUAL 6)
    message(FATAL_ERROR "M5.7 unknown/untracked fixture files present")
endif()
message(STATUS "PASS: M5.7 model provenance and five SHA-256-pinned synthetic media fixtures")
