# M7.1: offline, no model download or Python runtime required.
if(NOT DEFINED CHROMASCOPE_SOURCE_ROOT)
  message(FATAL_ERROR "CHROMASCOPE_SOURCE_ROOT is required")
endif()
set(_root "${CHROMASCOPE_SOURCE_ROOT}")
file(READ "${_root}/models/selected_model.json" _selected)
file(READ "${_root}/models/model_provenance.json" _provenance)
file(READ "${_root}/models/person_evaluation_policy.json" _audit)
foreach(_json IN ITEMS _selected _provenance _audit)
  string(JSON _type ERROR_VARIABLE _error TYPE "${${_json}}")
  if(_error OR NOT _type STREQUAL "OBJECT")
    message(FATAL_ERROR "Invalid model JSON record: ${_json}")
  endif()
endforeach()
string(JSON _selected_hash GET "${_selected}" artifact_sha256)
string(JSON _provenance_hash GET "${_provenance}" sha256)
string(JSON _audit_hash GET "${_audit}" model_sha256)
if(NOT _selected_hash STREQUAL _audit_hash OR NOT _audit_hash STREQUAL _provenance_hash)
  message(FATAL_ERROR "M7.1 person evaluation must use the pinned M5.1/M5.7 model")
endif()
string(JSON _class GET "${_audit}" class_id)
string(JSON _label GET "${_audit}" class_name)
string(JSON _state GET "${_audit}" evaluation_status)
string(JSON _license GET "${_audit}" license_spdx)
string(JSON _model_license GET "${_selected}" license_spdx)
if(NOT _class STREQUAL "0" OR NOT _label STREQUAL "person" OR
   NOT _state STREQUAL "protocol_prepared_no_project_accuracy_result" OR
   NOT _license STREQUAL "Apache-2.0" OR NOT _license STREQUAL _model_license)
  message(FATAL_ERROR "Person class/license/evaluation state drift")
endif()
string(JSON _coco50 GET "${_audit}" upstream_benchmark person_ap50)
string(JSON _coco95 GET "${_audit}" upstream_benchmark person_ap50_95)
if(NOT _coco50 EQUAL 0.675 OR NOT _coco95 EQUAL 0.418)
  message(FATAL_ERROR "M7.1 upstream person metrics drifted")
endif()
string(JSON _complete GET "${_audit}" local_evaluation requires_complete_jsonl)
string(JSON _ground_truth GET "${_audit}" local_evaluation requires_independently_reviewed_ground_truth)
string(JSON _no_weights GET "${_audit}" local_evaluation bundle_model_weights)
if(NOT _complete OR NOT _ground_truth OR _no_weights)
  message(FATAL_ERROR "M7.1 protocol must require complete labeled data and exclude weights")
endif()
foreach(_path IN ITEMS "docs/M7_1_PERSON_MODEL_EVALUATION.md" "models/NANODET_NOTICES.md"
    "licenses/OpenCV-Zoo-NanoDet-Apache-2.0.txt" "scripts/evaluate_person_detections.py")
  if(NOT EXISTS "${_root}/${_path}")
    message(FATAL_ERROR "Missing person evaluation/license record: ${_path}")
  endif()
endforeach()
message(STATUS "PASS: M7.1 person class, model SHA, protocol and Apache attribution consistent")
