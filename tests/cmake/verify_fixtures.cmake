cmake_minimum_required(VERSION 3.24)
# Run as cmake -DCHROMASCOPE_FIXTURE_DIR=... -DCHROMASCOPE_FIXTURE_MANIFEST=... -P ...
if(NOT DEFINED CHROMASCOPE_FIXTURE_DIR OR NOT DEFINED CHROMASCOPE_FIXTURE_MANIFEST)
    message(FATAL_ERROR "fixture directory and manifest are required")
endif()
if(NOT EXISTS "${CHROMASCOPE_FIXTURE_MANIFEST}")
    message(FATAL_ERROR "missing fixture manifest: ${CHROMASCOPE_FIXTURE_MANIFEST}")
endif()
file(STRINGS "${CHROMASCOPE_FIXTURE_MANIFEST}" _manifest)
set(_seen "")
foreach(_line IN LISTS _manifest)
    string(STRIP "${_line}" _line)
    if(_line STREQUAL "")
        continue()
    endif()
    if(NOT _line MATCHES "^([a-zA-Z0-9_.-]+)[ \t]+([0-9a-f]+)$")
        message(FATAL_ERROR "invalid fixture manifest entry: ${_line}")
    endif()
    set(_filename "${CMAKE_MATCH_1}")
    set(_checksum "${CMAKE_MATCH_2}")
    string(LENGTH "${_checksum}" _checksum_length)
    if(NOT _checksum_length EQUAL 64)
        message(FATAL_ERROR "invalid SHA-256 for ${_filename}")
    endif()
    if(NOT _filename MATCHES "^s[1-4]\\.jpg$")
        message(FATAL_ERROR "unexpected fixture name: ${_filename}")
    endif()
    if(_filename IN_LIST _seen)
        message(FATAL_ERROR "duplicate fixture entry: ${_filename}")
    endif()
    list(APPEND _seen "${_filename}")
    set(_image "${CHROMASCOPE_FIXTURE_DIR}/${_filename}")
    if(NOT EXISTS "${_image}")
        message(FATAL_ERROR "missing fixture: ${_image}")
    endif()
    file(SHA256 "${_image}" _actual)
    if(NOT _actual STREQUAL _checksum)
        message(FATAL_ERROR "fixture checksum mismatch: ${_filename}")
    endif()
endforeach()
list(LENGTH _seen _count)
if(NOT _count EQUAL 4)
    message(FATAL_ERROR "fixture manifest must contain four distinct original images (found ${_count})")
endif()
message(STATUS "PASS: verified SHA-256 of all ${_count} historical Skittles JPEG fixtures")
